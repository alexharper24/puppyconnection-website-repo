# Local simulation settings for pc-portal. Copy to .dev.vars (gitignored); app/dev/setup.mjs
# does it for you. Never put these in wrangler.jsonc.
DEV_MODE=local
EMAIL_MODE=log
PAYMENTS_MODE=sim
# Turnstile is skipped locally when these are empty. Cloudflare publishes always-pass test
# keys for trying the widget: site key 1x00000000000000000000AA and secret
# 1x0000000000000000000000000000000AA.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Continue with Google. Empty means the button does not show. The values below are for the
# local test (dev/google-test.mjs), which runs a stand-in Google on port 8799. The *_URL
# overrides are honored only when DEV_MODE is local.
GOOGLE_CLIENT_ID=local-test-client.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=local-test-secret
GOOGLE_TOKEN_URL=http://localhost:8799/token
GOOGLE_JWKS_URL=http://localhost:8799/certs
