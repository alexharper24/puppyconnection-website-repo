// The hosted TEST deployment of the portal, on the Puppy Connection Cloudflare account.
// Deploy from app/portal:  wrangler deploy --config wrangler.hosted.jsonc
// DEV_MODE staging (plan P7.3) makes this copy look like production, with no "test version"
// notices, while the test helpers stay for as long as their provider settings ask for them.
// The mailbox exists while EMAIL_MODE is log and the practice checkout while PAYMENTS_MODE is
// sim, both with no password. Each browser's mailbox shows only the mail for addresses it
// signed up with, and a practice checkout opens only for the breeder who started it. Leave
// EMAIL_MODE and PAYMENTS_MODE alone until real email (D9) and Stripe test keys (F1) are set,
// or sign-in and payment stop. hosted-open is the same with the notices shown. Production
// gets its own config with DEV_MODE unset (docs/launch-checklist.md, L7).
{
  "name": "portal",
  "account_id": "4f6e9dc25ab751960763628b06e6c108",
  "main": "worker.js",
  "compatibility_date": "2026-08-18",
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "d1_databases": [
    { "binding": "DB", "database_name": "puppyconnection", "database_id": "4556bf68-fa4a-406f-9b98-2f64006ea00b" }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "puppyconnection-files" }],
  "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "4101", "simple": { "limit": 10, "period": 60 } }],
  // Two of the free plan's five cron triggers. lib/jobs.js says what each one runs.
  "triggers": { "crons": ["*/15 * * * *", "0 13 * * *"] },
  "vars": {
    // Turnstile widget "Puppy Connection breeder portal" in the Puppy Connection account (2026-10-02).
    // The site key is public by design. TURNSTILE_SECRET is a secret, set with wrangler secret put.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFMKWRvBD106y7VJ",
    "TURNSTILE_HOSTNAME": "portal.puppyconnection.workers.dev",
    // Google OAuth client in the "Puppy Connection staging" Cloud project (Alex's account, testing mode,
    // 2026-10-04). The client ID is public; GOOGLE_CLIENT_SECRET is a secret, set with wrangler secret put.
    "GOOGLE_CLIENT_ID": "751105615126-cu5h48psv53a59nci3e9g5u0n0mmfuir.apps.googleusercontent.com",
    "PORTAL_ORIGIN": "https://portal.puppyconnection.workers.dev",
    "ADMIN_ORIGIN": "https://admin.puppyconnection.workers.dev",
    // Plan P2.2. The public site, for the View on the site links.
    "SITE_ORIGIN": "https://site.puppyconnection.workers.dev",
    // Publishing (decisions D10 and D11, and Alex 2026-10-06). PUBLISH_MODE hook POSTs the site
    // Worker's Workers Builds deploy hook, the secret PUBLISH_HOOK_URL, and the build in
    // alexharper24/puppyconnection-site fetches /data/export.json from here. Until the secret is
    // set the publish does nothing and says so. The GITHUB_* settings are for PUBLISH_MODE commit
    // only, kept for later (for example on Workers Paid), and are unused in hook mode, so the
    // GITHUB_TOKEN secret already on staging writes nothing.
    "PUBLISH_MODE": "hook",
    "GITHUB_REPO": "alexharper24/puppyconnection-site",
    "GITHUB_BRANCH": "main",
    "PUBLISH_DIR": "",
    "DEV_MODE": "staging",
    "EMAIL_MODE": "log",
    "PAYMENTS_MODE": "sim"
  }
}
