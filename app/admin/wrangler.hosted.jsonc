// The hosted TEST deployment of the operator screens, on the Puppy Connection Cloudflare account.
// Deploy from app/admin:  wrangler deploy --config wrangler.hosted.jsonc
// Signed in with Cloudflare Access on the dry-snowflake-0e9c team (an emailed one-time code, as
// the Teapup editor uses), and then the people table decides who is an operator.
// DEV_MODE staging (plan P7.3) shows no "test copy" notice and uses no password gate and no
// DEV_IDENTITY. The operators' mailbox at /dev/mail stays while EMAIL_MODE is log, linked from
// the menu. hosted-access is the same with the notice shown. The Access application is
// "Puppy Connection admin" in that account.
{
  "name": "admin",
  "account_id": "4f6e9dc25ab751960763628b06e6c108",
  "main": "worker.js",
  "compatibility_date": "2026-08-18",
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "d1_databases": [
    { "binding": "DB", "database_name": "puppyconnection", "database_id": "4556bf68-fa4a-406f-9b98-2f64006ea00b" }
  ],
  // Plan P4.4. Publish now with PUBLISH_MODE hook (or commit or portal) asks the portal to publish
  // through this binding, at /internal/publish, which answers nothing that arrives any other way.
  // The portal calls the site's deploy hook (lib/publish.js). Until PUBLISH_HOOK_URL is set on the
  // portal, Publish now says publishing is not set up.
  "services": [{ "binding": "PORTAL", "service": "portal" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "puppyconnection-files" }],
  "vars": {
    "PORTAL_ORIGIN": "https://portal.puppyconnection.workers.dev",
    "ADMIN_ORIGIN": "https://admin.puppyconnection.workers.dev",
    "PUBLISH_MODE": "hook",
    "DEV_MODE": "staging",
    "EMAIL_MODE": "log",
    "PAYMENTS_MODE": "sim",
    "ACCESS_TEAM_DOMAIN": "dry-snowflake-0e9c",
    "ACCESS_AUD": "ed2540a85f73e26cbd10f0ab48a416aac70dad4ffecf8cc5f01f8553643debfa"
  }
}
