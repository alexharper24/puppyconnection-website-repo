// The public site Worker run locally, for testing the view and click beacon (plan P2.5,
// dev/portal-features-test.mjs). Build its pages first with node app/dev/build-site.mjs, then
// from C:\Git_Repos:
//   wrangler dev --config puppyconnection-website-repo/app/site/wrangler.jsonc --persist-to puppyconnection-website-repo/app/.state --port 8791
// It shares the local database with pc-portal and pc-admin through the same --persist-to.
// The hosted copy is wrangler.hosted.jsonc.
{
  "$schema": "../../../teapup-website-repo/admin/node_modules/wrangler/config-schema.json",
  "name": "pc-site",
  "main": "worker.js",
  "compatibility_date": "2026-08-18",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "puppyconnection", "database_id": "00000000-0000-4000-8000-000000000c01" }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "puppyconnection-files" }],
  "ratelimits": [
    { "name": "BEACON_LIMITER", "namespace_id": "4102", "simple": { "limit": 30, "period": 60 } },
    { "name": "BEACON_ONCE", "namespace_id": "4103", "simple": { "limit": 1, "period": 60 } }
  ]
}
