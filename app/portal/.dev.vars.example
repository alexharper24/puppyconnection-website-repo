# Local simulation settings for pc-portal. Copy to .dev.vars (gitignored); app/dev/setup.mjs
# does it for you. Never put these in wrangler.jsonc.
DEV_MODE=local
EMAIL_MODE=log
PAYMENTS_MODE=sim
# Turnstile is skipped locally when these are empty. Cloudflare publishes always-pass test
# keys for trying the widget: site key 1x00000000000000000000AA and secret
# 1x0000000000000000000000000000000AA.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Continue with Google. Empty means the button does not show. The values below are for the
# local test (dev/google-test.mjs), which runs a stand-in Google on port 8799. The *_URL
# overrides are honored only when DEV_MODE is local.
GOOGLE_CLIENT_ID=local-test-client.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=local-test-secret
GOOGLE_TOKEN_URL=http://localhost:8799/token
GOOGLE_JWKS_URL=http://localhost:8799/certs

# Publishing the site (plan P4.3). These point the publish at the stand-in GitHub that
# dev/publish-test.mjs runs on 8798, with its made-up token. GITHUB_API is honored only while
# DEV_MODE is local. A deployed portal gets the real GITHUB_TOKEN as a secret (plan F4) and
# GITHUB_REPO as a var. Leave GITHUB_TOKEN empty to see the publish say it is not set up.
# The local portal publishes in commit mode, so publish-test part 2 can watch the commits. Staging
# runs hook mode (wrangler.hosted.jsonc), and publish-test part 4 starts a second local portal on
# 8793 in hook mode against a stand-in deploy hook. PUBLISH_HOOK_URL is a secret when deployed.
PUBLISH_MODE=commit
GITHUB_TOKEN=local-test-token
GITHUB_REPO=local/puppyconnection-site
GITHUB_API=http://localhost:8798
