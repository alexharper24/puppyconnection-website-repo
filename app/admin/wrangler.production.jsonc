// PRODUCTION config for the admin (launch checklist L7, built 2026-10-26 on Alex's instruction).
// Same Worker, database and bucket as staging: staging becomes production once the test data is
// cleared (workplan B12). Differences from wrangler.hosted.jsonc:
//   - DEV_MODE removed, so the test mailbox, the practice checkout and the test notices are gone.
//   - STRIPE_MODE live, with Amber's live price and her account's current API version.
//   - EMAIL_ALLOWLIST removed, so email reaches every breeder and subscriber.
// Secrets are shared with staging because it is the same Worker: set the live STRIPE_SECRET_KEY
// (and on the portal STRIPE_WEBHOOK_SECRET for webhook we_1UT6dbCVXPZ95g1DTrAn6V7W) immediately
// before deploying this file, never while wrangler.hosted.jsonc is deployed.
// WARNING: deploying this takes real money and sends real email. Clear the test data first.
// Cutover (E2), 2026-10-31: the origins name the puppy-connection.com hostnames and the custom domain is in routes.
// Deploy from app/admin:  wrangler deploy --config wrangler.production.jsonc
{
  "name": "admin",
  "account_id": "4f6e9dc25ab751960763628b06e6c108",
  "main": "worker.js",
  "compatibility_date": "2026-08-18",
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  // The real address since launch, 2026-10-31. workers.dev stays on so Stripe webhooks and the site build keep reaching it.
  "routes": [{ "pattern": "admin.puppy-connection.com", "custom_domain": true }],
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "d1_databases": [
    { "binding": "DB", "database_name": "puppyconnection", "database_id": "4556bf68-fa4a-406f-9b98-2f64006ea00b" }
  ],
  // Plan P4.4. Publish now with PUBLISH_MODE hook (or commit or portal) asks the portal to publish
  // through this binding, at /internal/publish, which answers nothing that arrives any other way.
  // The portal calls the site's deploy hook (lib/publish.js). Until PUBLISH_HOOK_URL is set on the
  // portal, Publish now says publishing is not set up.
  "services": [{ "binding": "PORTAL", "service": "portal" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "puppyconnection-files" }],
  "vars": {
    "PORTAL_ORIGIN": "https://portal.puppy-connection.com",
    // Workplan A11. The public site, for the Visit site link. https://puppy-connection.com at cutover (E2).
    "SITE_ORIGIN": "https://www.puppy-connection.com",
    "ADMIN_ORIGIN": "https://admin.puppy-connection.com",
    "PUBLISH_MODE": "hook",
    // Real email through Resend on Puppy Connection's verified domain (workplan B3 and B7, Alex
    // receive mail, list sends included, and /dev/mail is gone while EMAIL_MODE is resend.
    "EMAIL_MODE": "resend",
    "EMAIL_FROM": "Puppy Connection <notices@puppy-connection.com>",
    "EMAIL_REPLY_TO": "info@puppy-connection.com",
    // Workplan B9 (Amber, 2026-10-25). New breeders waiting for approval and listing reports go here
    // instead of to the operators in people. Failure alerts stay with the owners. Unset, the old rule.
    "NOTICE_TO": "info@puppy-connection.com",
    "PAYMENTS_MODE": "stripe",
    "STRIPE_MODE": "live",
    "STRIPE_API_VERSION": "2026-09-30.endive",
    "STRIPE_PRICE_ID": "price_1UT6ZpCVXPZ95g1DE73UUTSC",
    "ACCESS_TEAM_DOMAIN": "dry-snowflake-0e9c",
    "ACCESS_AUD": "ed2540a85f73e26cbd10f0ab48a416aac70dad4ffecf8cc5f01f8553643debfa",
    // Puppy videos (workplan A3, lib/stream.js). Videos stay off until Stream is subscribed on
    // this account and Alex sets the STREAM_API_TOKEN secret (a token with Stream Edit). Then set
    // STREAM_MODE to "stream" and STREAM_CUSTOMER_CODE to the <code> in the account's
    // customer-<code>.cloudflarestream.com, and redeploy the portal and the admin.
    // Video is held for now (Alex, 2026-10-25). Set this back to "stream" to switch it on; the key and customer code stay.
    "STREAM_MODE": "off",
    "STREAM_CUSTOMER_CODE": "ui4bftd2nmemqgdc",
    "STREAM_ACCOUNT_ID": "4f6e9dc25ab751960763628b06e6c108"
  }
}
