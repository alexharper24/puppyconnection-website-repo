// The public site for the hosted TEST deployment, reading live from the database's views.
// Build, then deploy from app/site:
//   node ../dev/build-site.mjs && wrangler deploy --config wrangler.hosted.jsonc
// Open to anyone, with no password, because it reads only the database's public views and
// serves only photos of listed puppies. The portal and the admin keep their TEST_GATE password.
{
  "name": "site",
  "account_id": "4f6e9dc25ab751960763628b06e6c108",
  "main": "worker.js",
  "compatibility_date": "2026-08-18",
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "puppyconnection", "database_id": "4556bf68-fa4a-406f-9b98-2f64006ea00b" }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "puppyconnection-files" }]
}
