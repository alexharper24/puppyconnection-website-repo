{
  "$schema": "../../../teapup-website-repo/admin/node_modules/wrangler/config-schema.json",
  "name": "pc-admin",
  "main": "worker.js",
  "compatibility_date": "2026-08-18",
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,

  // A SEPARATE Worker from the portal because Cloudflare Access protects a whole Worker or
  // none of it (spec 2). Deployed without Access configured, identity fails closed and every
  // path answers 403, which is the correct state until Amber's Access application exists.
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },

  "d1_databases": [
    { "binding": "DB", "database_name": "puppyconnection", "database_id": "00000000-0000-4000-8000-000000000c01" }
  ],
  // Plan P4.4. Publish now with PUBLISH_MODE portal asks the portal to publish through this binding,
  // at /internal/publish, which answers nothing that arrives any other way. PUBLISH_MODE is unset
  // (mark) while the staging site reads the database live.
  "services": [{ "binding": "PORTAL", "service": "pc-portal" }],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "puppyconnection-files" }
  ],

  "vars": {
    "PORTAL_ORIGIN": "http://localhost:8787",
    "ADMIN_ORIGIN": "http://localhost:8788",
    // Filled in when Access is set up on Amber's account (breeder-site-backend worker-and-auth).
    "ACCESS_TEAM_DOMAIN": "PASTE_TEAM_DOMAIN",
    "ACCESS_AUD": "PASTE_APPLICATION_AUD"
  }
}
